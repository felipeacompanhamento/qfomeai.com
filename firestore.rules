rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      // Use cached get() for efficiency
      return isAuthenticated() && (
        (request.auth.token.email == "felipeacompanhamento@gmail.com" && request.auth.token.email_verified == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN')
      );
    }

    // -- CANONICAL USER MODEL HELPERS --
    function getAuthUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isClient(data) {
      return data.accountType == 'CLIENT' || data.tipo_usuario == 'cliente' || data.role == 'CLIENT';
    }

    function hasProtectedFieldChanges() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'tipo_usuario', 'accountType', 'permissions', 'status', 'active', 'restaurantId']);
    }
    // ----------------------------------

    function isRestaurantAdmin(restaurantId) {
      return isAuthenticated() && (
        (request.auth.token.email == "felipeacompanhamento@gmail.com" && request.auth.token.email_verified == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN') ||
        request.auth.uid == restaurantId ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.restaurantId == restaurantId &&
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tipo_usuario in ['restaurant', 'restaurante', 'admin', 'owner'] ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['RESTAURANT', 'RESTAURANT_ADMIN', 'MANAGER', 'ADMIN', 'OWNER']) &&
          !(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tipo_usuario == 'waiter' ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'WAITER')
        )
      );
    }

    function isRestaurantOwner(restaurantId) {
      return isRestaurantAdmin(restaurantId);
    }

    function isRestaurantWaiter(restaurantId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.restaurantId == restaurantId &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tipo_usuario == 'waiter' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'WAITER')
      );
    }

    function isAnyRestaurant() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/restaurants/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tipo_usuario in ['restaurant', 'restaurante']) ||
        (request.auth.token.email == "felipeacompanhamento@gmail.com" && request.auth.token.email_verified == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN')
      );
    }

    function isWaiterProfile(data) {
      return data != null && (data.tipo_usuario == 'waiter' || data.role == 'WAITER');
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users
    match /users/{userId} {
      // PROMPT 4.8.13 - RULES
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || 
        isAdmin() || 
        (
          resource != null && 
          !isClient(getAuthUserData()) && 
          resource.data.restaurantId == getAuthUserData().restaurantId
        )
      );

      // Creation should be handled exclusively by the backend using Admin SDK. 
      // Only CLIENTS can self-create from frontend.
      allow create: if isAuthenticated() && 
                    request.auth.uid == userId && 
                    isClient(request.resource.data);

      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          // Self update: prevent changing protected fields
          request.auth.uid == userId && !hasProtectedFieldChanges()
        ) ||
        (
          // Administering team members in same restaurant
          resource.data.restaurantId == getAuthUserData().restaurantId &&
          request.resource.data.restaurantId == resource.data.restaurantId &&
          !hasProtectedFieldChanges() && // Administering must be done through backend to change protected fields
          (
            (getAuthUserData().role == 'OWNER') ||
            (getAuthUserData().role == 'RESTAURANT_ADMIN' && resource.data.role != 'OWNER') ||
            (getAuthUserData().role == 'MANAGER' && resource.data.role != 'OWNER' && resource.data.role != 'RESTAURANT_ADMIN')
          )
        )
      );
      
      allow delete: if isAdmin();
      
      match /enderecos/{enderecoId} {
        allow read: if request.auth != null && (
          request.auth.uid == userId || 
          (request.auth.token.email == "felipeacompanhamento@gmail.com" && request.auth.token.email_verified == true) ||
          isAdmin() ||
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tipo_usuario in ['restaurant', 'restaurante', 'admin']
          )
        );
        allow write: if request.auth != null && (request.auth.uid == userId || (request.auth.token.email == "felipeacompanhamento@gmail.com" && request.auth.token.email_verified == true));
      }

      match /transacoes_carteira/{transactionId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || (request.auth.token.email == "felipeacompanhamento@gmail.com" && request.auth.token.email_verified == true));
      }

      match /cupons/{cupomId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || (request.auth.token.email == "felipeacompanhamento@gmail.com" && request.auth.token.email_verified == true));
      }

      match /favoritos/{favoritoId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || (request.auth.token.email == "felipeacompanhamento@gmail.com" && request.auth.token.email_verified == true));
      }
    }

    // Restaurants
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.auth.uid == restaurantId || isAdmin());
      allow update: if isRestaurantOwner(restaurantId) || isAdmin() || 
                    (isAuthenticated() && 
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['media_avaliacao', 'total_avaliacoes']) &&
                     request.resource.data.media_avaliacao is number &&
                     request.resource.data.total_avaliacoes is number);
      allow delete: if isAdmin();

      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isRestaurantOwner(restaurantId) || isAdmin();
      }

      match /drivers/{driverId} {
        allow read: if isRestaurantOwner(restaurantId) || isAdmin() || (isAuthenticated() && request.auth.uid == driverId);
        allow write: if false; // Block all legacy writes!
      }

      match /waiters/{waiterId} {
        allow read: if isRestaurantOwner(restaurantId) || isAdmin() || (
          isAuthenticated() &&
          request.auth.uid == waiterId &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.restaurantId == restaurantId &&
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tipo_usuario == 'waiter' ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'WAITER'
          )
        );
        allow write: if false; // Block all legacy writes!
      }

      // PROMPT 4.8.22 - Consolidated Staff Profiles
      match /staffProfiles/{profileId} {
        allow read: if isRestaurantOwner(restaurantId) || isAdmin() || (isAuthenticated() && request.auth.uid == profileId);
        allow create, delete: if isRestaurantOwner(restaurantId) || isAdmin();
        allow update: if isRestaurantOwner(restaurantId) || isAdmin() || (
          // Allow operational updates to their own role-specific or updated timestamp data
          isAuthenticated() &&
          request.auth.uid == profileId &&
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roleSpecificData', 'updatedAt']) ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])
          )
        );

        match /processedActions/{actionId} {
          allow read: if isRestaurantOwner(restaurantId) || isAdmin() || (isAuthenticated() && request.auth.uid == profileId);
          allow write: if isAuthenticated() && request.auth.uid == profileId;
        }
      }

      match /dataCleanupRequests/{requestId} {
        allow read, write: if isRestaurantOwner(restaurantId) || isAdmin();
      }

      match /mesas/{mesaId} {
        allow read: if isRestaurantOwner(restaurantId) || isAdmin() || isRestaurantWaiter(restaurantId);
        allow create, update, delete: if isRestaurantOwner(restaurantId) || isAdmin();
      }

      match /comandas/{comandaId} {
        allow read, create, update: if isRestaurantOwner(restaurantId) || isAdmin() || isRestaurantWaiter(restaurantId);
        allow delete: if isRestaurantOwner(restaurantId) || isAdmin();
      }

      match /halls/{hallId} {
        allow read: if isRestaurantOwner(restaurantId) || isAdmin() || isRestaurantWaiter(restaurantId);
        allow write: if isRestaurantOwner(restaurantId) || isAdmin();
      }

      match /tables/{tableId} {
        allow read: if isRestaurantOwner(restaurantId) || isAdmin() || isRestaurantWaiter(restaurantId);
        allow write: if isRestaurantOwner(restaurantId) || isAdmin();
      }

      match /tabs/{tabId} {
        allow read: if isRestaurantOwner(restaurantId) || isAdmin() || isRestaurantWaiter(restaurantId);
        allow create, update, delete: if isRestaurantOwner(restaurantId) || isAdmin();
      }

      match /extras/{extraId} {
        allow read: if true;
        allow write: if isRestaurantOwner(restaurantId) || isAdmin();
      }

      match /products/{productId} {
        allow read: if true;
        allow write: if isRestaurantOwner(restaurantId) || isAdmin();
      }

      match /promotions/{promotionId} {
        allow read: if true;
        allow write: if isRestaurantOwner(restaurantId) || isAdmin();
      }

      match /optionGroups/{groupId} {
        allow read: if true;
        allow write: if isRestaurantOwner(restaurantId) || isAdmin();
      }

      match /optionItems/{optionId} {
        allow read: if true;
        allow write: if isRestaurantOwner(restaurantId) || isAdmin();
      }

      match /sizes/{sizeId} {
        allow read: if true;
        allow write: if isRestaurantOwner(restaurantId) || isAdmin();
      }

      match /schedules/{scheduleId} {
        allow read: if true;
        allow write: if isRestaurantOwner(restaurantId) || isAdmin();
      }

      match /contract/{contractId} {
        allow read, write: if isRestaurantOwner(restaurantId) || isAdmin();
      }

      match /delivery_areas/{areaId} {
        allow read: if true;
        allow write: if isRestaurantOwner(restaurantId) || isAdmin();
      }

      match /avaliacoes/{avaliacaoId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update, delete: if isRestaurantOwner(restaurantId) || isAdmin() || 
                              (isAuthenticated() && request.auth.uid == resource.data.cliente_id);
      }

      match /integration_logs/{logId} {
        allow read: if isRestaurantOwner(restaurantId) || isAdmin();
        allow write: if false; // Only server (Admin SDK) writes to this collection
      }

      match /deliveries/{deliveryId} {
        allow read: if isRestaurantOwner(restaurantId) || isAdmin() || (
          isAuthenticated() && (
            resource.data.driverId == request.auth.uid || 
            resource.data.assignedDriverId == request.auth.uid ||
            (resource.data.responsibleDriverId == request.auth.uid)
          )
        );
        allow create: if isRestaurantOwner(restaurantId) || isAdmin();
        allow update: if isRestaurantOwner(restaurantId) || isAdmin() || (
          isAuthenticated() && (
            resource.data.driverId == request.auth.uid || 
            resource.data.assignedDriverId == request.auth.uid ||
            (resource.data.responsibleDriverId == request.auth.uid)
          )
        );
        allow delete: if isRestaurantOwner(restaurantId) || isAdmin();
      }

      match /deliveryLogs/{logId} {
        allow read: if isRestaurantOwner(restaurantId) || isAdmin() || (
          isAuthenticated() && (
            resource.data.driverId == request.auth.uid
          )
        );
        allow create: if isRestaurantOwner(restaurantId) || isAdmin() || (
          isAuthenticated() && (
            request.resource.data.driverId == request.auth.uid
          )
        );
        allow update, delete: if isRestaurantOwner(restaurantId) || isAdmin();
      }

      // Auxiliares e Idempotência (Módulo Financeiro)
      match /processedActions/{actionId} {
        allow read, write: if false;
      }

      match /active_caixa/{activeId} {
        allow read, write: if false;
      }

      match /activeCashRegister/{activeId} {
        allow read, write: if false;
      }

      match /idempotency/{idempotencyId} {
        allow read, write: if false;
      }

      // Módulo Financeiro: Caixas e Movimentações
      match /caixas/{caixaId} {
        allow read: if isRestaurantOwner(restaurantId);
        allow write: if false; // Todas as alterações de caixa ocorrem via Backend API

        match /movimentacoes/{movimentacaoId} {
          allow read: if isRestaurantOwner(restaurantId);
          allow write: if false; // Lançamentos/movimentações ocorrem via Backend API
        }
      }

      // Módulo Financeiro: Contas a Receber e Recebimentos
      match /contasReceber/{contaId} {
        allow read: if isRestaurantOwner(restaurantId);
        allow write: if false; // Criação/atualização de contas a receber ocorrem via Backend API

        match /recebimentos/{recebimentoId} {
          allow read: if isRestaurantOwner(restaurantId);
          allow write: if false; // Recebimentos ocorrem via Backend API
        }
      }

      // Módulo Financeiro: Contas a Pagar e Pagamentos
      match /contasPagar/{contaId} {
        allow read: if isRestaurantOwner(restaurantId);
        allow write: if false; // Criação/atualização de contas a pagar ocorrem via Backend API

        match /pagamentos/{pagamentoId} {
          allow read: if isRestaurantOwner(restaurantId);
          allow write: if false; // Pagamentos ocorrem via Backend API
        }
      }
    }

    // Delivery Areas (Collection Group)
    match /{path=**}/delivery_areas/{areaId} {
      allow read: if true;
      allow write: if isAuthenticated() && (
        isRestaurantOwner(resource.data.restaurant_id) || 
        isAdmin()
      );
    }

    // Reviews (Collection Group)
    match /{path=**}/avaliacoes/{avaliacaoId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        isRestaurantOwner(resource.data.restaurant_id) || 
        isAdmin() ||
        request.auth.uid == resource.data.cliente_id
      );
    }

    // Schedules (Collection Group)
    match /{path=**}/schedules/{scheduleId} {
      allow read: if true;
      allow write: if isAuthenticated() && (
        isRestaurantOwner(resource.data.restaurant_id) || 
        isAdmin()
      );
    }

    // Products (Collection Group)
    match /{path=**}/products/{productId} {
      allow read: if true;
      allow write: if isAuthenticated() && (
        isRestaurantOwner(resource.data.restaurant_id) || 
        isAdmin()
      );
    }

    // Deliveries (Collection Group)
    match /{path=**}/deliveries/{deliveryId} {
      allow read: if isAuthenticated() && (
        isRestaurantOwner(resource.data.restaurantId) ||
        isAdmin() ||
        resource.data.driverId == request.auth.uid ||
        resource.data.assignedDriverId == request.auth.uid ||
        resource.data.customerId == request.auth.uid ||
        resource.data.cliente_id == request.auth.uid ||
        (resource.data.responsibleDriverId == request.auth.uid)
      );
      allow write: if isAuthenticated() && (
        isRestaurantOwner(resource.data.restaurantId) ||
        isAdmin()
      );
    }

    // Drivers (Collection Group)
    match /{path=**}/drivers/{driverId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == driverId ||
        isRestaurantOwner(resource.data.restaurantId) ||
        isAdmin()
      );
    }

    // Orders
    match /restaurants/{restaurantId}/orders/{orderId} {
      allow read: if isAuthenticated() && (
        isRestaurantOwner(restaurantId) || 
        isAdmin() ||
        request.auth.uid == resource.data.cliente_id ||
        resource.data.driverId == request.auth.uid ||
        resource.data.entregador_id == request.auth.uid ||
        resource.data.assignedDriverId == request.auth.uid
      );
      allow create: if isAuthenticated() && 
        (!('source' in request.resource.data) || request.resource.data.source != 'COUNTER') &&
        request.resource.data.cliente_id == request.auth.uid &&
        (!('restaurantId' in request.resource.data) || request.resource.data.restaurantId == restaurantId) &&
        (!('restaurante_id' in request.resource.data) || request.resource.data.restaurante_id == restaurantId) &&
        (!('restaurant_id' in request.resource.data) || request.resource.data.restaurant_id == restaurantId) &&
        (!('status' in request.resource.data) || request.resource.data.status in ['pendente', 'aguardando_pagamento']) &&
        (!('status_entrega' in request.resource.data) || request.resource.data.status_entrega in ['waiting', 'pending']) &&
        (!('deliveryStatus' in request.resource.data) || request.resource.data.deliveryStatus in ['UNASSIGNED', 'PENDING']);
      allow update: if isAuthenticated() && (
        isRestaurantOwner(restaurantId) || 
        isAdmin() ||
        (
          request.auth.uid == resource.data.cliente_id &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'avaliacao', 'comentario_avaliacao', 'nota_avaliacao', 'confirmado_cliente', 'confirmado_cliente_em'
          ])
        ) ||
        (
          (resource.data.driverId == request.auth.uid || resource.data.entregador_id == request.auth.uid || resource.data.assignedDriverId == request.auth.uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'status_entrega', 'horario_saida', 'horario_entrega', 'driverId', 'entregador_id', 'driverName', 'historico_entrega', 'data_finalizado',
            'deliveryStatus', 'deliveryType', 'assignedDriverId', 'assignedDriverName', 'assignedDriverPhone', 'assignedAt', 'assignedBy'
          ])
        )
      );
    }

    // Orders (Collection Group for Clients and Admin)
    match /{path=**}/orders/{orderId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.cliente_id || 
        isRestaurantOwner(resource.data.restaurant_id) ||
        isAdmin() ||
        resource.data.driverId == request.auth.uid ||
        resource.data.entregador_id == request.auth.uid ||
        resource.data.assignedDriverId == request.auth.uid
      );
      // Create and Update operations must occur via the specific restaurant subcollection path only.
      allow create, update: if false;
    }

    // Audit Logs (Top-level)
    match /audit_logs/{logId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        (
          resource != null && 
          !isClient(getAuthUserData()) && 
          resource.data.restaurantId == getAuthUserData().restaurantId
        )
      );
      // Frontend cannot edit audit logs
      allow write: if false;
    }

    // processedActions (Collection Group)
    match /{path=**}/processedActions/{actionId} {
      allow read, write: if false;
    }

    // Banners
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories (Global)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reports
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Public Stats
    match /public_stats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Global Collections
    match /estados/{estadoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cidades/{cidadeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bairros/{bairroId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usos']) &&
        request.resource.data.usos == (('usos' in resource.data) ? resource.data.usos : 0) + 1
      );
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read: if isAdmin() || (isAuthenticated() && isRestaurantOwner(resource.data.restaurante_id));
      allow write: if isAdmin();
    }

    match /prestadores_servicos/{servicoId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Halls (Salões) - Top-level
    match /halls/{hallId} {
      allow read: if isAuthenticated() && (
        isRestaurantAdmin(resource.data.restaurantId) ||
        isAdmin() ||
        isRestaurantWaiter(resource.data.restaurantId)
      );
      allow create: if isAuthenticated() && (
        isRestaurantAdmin(request.resource.data.restaurantId) ||
        isAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        isRestaurantAdmin(resource.data.restaurantId) ||
        isAdmin()
      );
    }

    // Tables (Mesas) - Top-level
    match /tables/{tableId} {
      allow read: if isAuthenticated() && (
        isRestaurantAdmin(resource.data.restaurantId) ||
        isAdmin() ||
        isRestaurantWaiter(resource.data.restaurantId)
      );
      allow create: if isAuthenticated() && (
        isRestaurantAdmin(request.resource.data.restaurantId) ||
        isAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        isRestaurantAdmin(resource.data.restaurantId) ||
        isAdmin()
      );
    }

    // Tabs (Comandas) - Top-level
    match /tabs/{tabId} {
      allow read: if isAuthenticated() && (
        isRestaurantAdmin(resource.data.restaurantId) ||
        isAdmin() ||
        isRestaurantWaiter(resource.data.restaurantId)
      );
      allow create: if isAuthenticated() && (
        isRestaurantAdmin(request.resource.data.restaurantId) ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        isRestaurantAdmin(resource.data.restaurantId) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        isRestaurantAdmin(resource.data.restaurantId) ||
        isAdmin()
      );
    }
  }
}
