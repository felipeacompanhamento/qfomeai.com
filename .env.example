# ==============================================================================
# CONFIGURAÇÕES DA APLICAÇÃO E AMBIENTE (Application & Environment)
# ==============================================================================

# NODE_ENV: Ambiente de execução da aplicação (development, production, test). Opcional (padrão: development).
NODE_ENV="development"

# PORT: Porta HTTP em que o servidor Node.js/Express deve escutar (obrigatório em produção, padrão: 3000).
PORT=3000

# APP_URL: URL pública onde esta aplicação está hospedada (utilizada para callbacks OAuth, links e integrações). Opcional/Automático.
APP_URL="MY_APP_URL"

# APP_VERSION: Versão atual da aplicação. Opcional.
APP_VERSION="1.0.0"


# ==============================================================================
# INTELIGÊNCIA ARTIFICIAL (Gemini API)
# ==============================================================================

# GEMINI_API_KEY: Chave de API da Google Gemini para recursos de IA. Obrigatório para funcionalidades de IA.
GEMINI_API_KEY="MY_GEMINI_API_KEY"


# ==============================================================================
# FIREBASE & FIRESTORE (Client & Admin SDK)
# ==============================================================================

# GOOGLE_CLOUD_PROJECT: ID do projeto Google Cloud / Firebase. Opcional (detectado automaticamente).
GOOGLE_CLOUD_PROJECT=

# FIREBASE_SERVICE_ACCOUNT_KEY: Chave JSON ou Base64 da Conta de Serviço do Firebase Admin. Obrigatório para operações administrativas do backend.
FIREBASE_SERVICE_ACCOUNT_KEY=

# VITE_FIREBASE_API_KEY: Chave de API do Firebase Client SDK. Obrigatório para autenticação e Firestore no frontend.
VITE_FIREBASE_API_KEY=

# VITE_FIREBASE_AUTH_DOMAIN: Domínio de autenticação do Firebase. Obrigatório para autenticação web.
VITE_FIREBASE_AUTH_DOMAIN=

# VITE_FIREBASE_PROJECT_ID: ID do projeto Firebase no Client SDK. Obrigatório.
VITE_FIREBASE_PROJECT_ID=

# VITE_FIREBASE_STORAGE_BUCKET: Nome do bucket do Firebase Storage (Storage). Obrigatório para upload de arquivos.
VITE_FIREBASE_STORAGE_BUCKET=

# VITE_FIREBASE_MESSAGING_SENDER_ID: ID do remetente para Cloud Messaging (FCM). Opcional.
VITE_FIREBASE_MESSAGING_SENDER_ID=

# VITE_FIREBASE_APP_ID: ID do aplicativo Firebase no cliente. Obrigatório.
VITE_FIREBASE_APP_ID=

# VITE_FIREBASE_FIRESTORE_DATABASE_ID: ID do banco de dados Firestore (se não for o padrão '(default)'). Opcional.
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# VITE_FIREBASE_VAPID_KEY: Chave VAPID pública para notificações Push no navegador (Firebase Cloud Messaging). Opcional.
VITE_FIREBASE_VAPID_KEY=


# ==============================================================================
# INTEGRAÇÕES DE PAGAMENTO (Mercado Pago)
# ==============================================================================

# MERCADOPAGO_ACCESS_TOKEN (ou MP_ACCESS_TOKEN): Token de acesso de produção/sandbox do Mercado Pago para processamento de pagamentos. Obrigatório para integração de pagamentos MP.
MERCADOPAGO_ACCESS_TOKEN=
MP_ACCESS_TOKEN=


# ==============================================================================
# COMUNICAÇÃO E MENSAGERIA (WhatsApp & Webhooks)
# ==============================================================================

# WHATSAPP_TOKEN: Token de acesso da API do WhatsApp Cloud / Meta. Obrigatório para envio de mensagens via WhatsApp.
WHATSAPP_TOKEN=

# PHONE_NUMBER_ID: ID do número de telefone registrado na API do WhatsApp. Obrigatório para envio de mensagens.
PHONE_NUMBER_ID=

# WHATSAPP_WEBHOOK_VERIFY_TOKEN: Token de verificação de webhook para recepção de eventos do WhatsApp. Obrigatório para webhooks do WhatsApp.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# VITE_FACEBOOK_APP_ID: ID do aplicativo Facebook/Meta para integração no frontend. Opcional.
VITE_FACEBOOK_APP_ID=


# ==============================================================================
# GEOLOCALIZAÇÃO (Google Maps & Geocodificação)
# ==============================================================================

# GOOGLE_MAPS_API_KEY (ou GOOGLE_MAPS_PLATFORM_KEY): Chave da API Google Maps para geocodificação, rotas e endereços. Obrigatório para recursos de mapa e endereço.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_PLATFORM_KEY=


# ==============================================================================
# MONITORAMENTO, ALERTAS E LOGS
# ==============================================================================

# ALERT_WEBHOOK_URL: URL de webhook externo para notificações de alertas críticos do sistema. Opcional.
ALERT_WEBHOOK_URL=

# DISABLE_HMR: Desativa Hot Module Replacement no Vite quando configurado como true. Opcional.
DISABLE_HMR=false


# ==============================================================================
# RATE LIMITING, REDIS E TIMEOUTS DE INTEGRAÇÃO
# ==============================================================================

# REDIS_URL (ou REDIS_HOST): URL ou Host do servidor Redis para rate limiting distribuído em cluster. Opcional (utiliza Firestore / Memória local por padrão).
REDIS_URL=
REDIS_HOST=

# INTEGRATION_TIMEOUT: Tempo limite máximo (em milissegundos) para requisições a integrações externas. Opcional (padrão: 10000ms).
INTEGRATION_TIMEOUT=10000
